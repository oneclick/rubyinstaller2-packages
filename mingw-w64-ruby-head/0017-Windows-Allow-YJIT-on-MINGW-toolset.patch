diff --git a/tool/leaked-globals b/tool/leaked-globals
index c1a3fb42b8..22fbd8427b 100755
--- a/tool/leaked-globals
+++ b/tool/leaked-globals
@@ -129,5 +129,6 @@ def each(&block) open {|f| f.each(&block)} end
 when 1
   abort col.fail("1 un-prefixed symbol leaked")
 else
+  exit if RUBY_PLATFORM.include?("mingw")
   abort col.fail("#{count} un-prefixed symbols leaked")
